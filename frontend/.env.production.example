# Salin ke .env.production sebelum `pnpm build`.
# Sub-path tempat web di-deploy: https://smartfarming.umn.ac.id/soilmon/
# Halaman, file di public/ dan panggilan API ikut sub-path ini (API jadi /soilmon/api/v1/...).
# nginx menyajikan dist/ di /soilmon/ dan meneruskan /soilmon/api/ ke backend 127.0.0.1:3000/api/.
# Kosongkan atau hapus untuk deploy di root ("/"). Dev lokal (`pnpm dev`) tidak membaca file ini.
VITE_BASE_PATH=/soilmon/
