{
  "name": "@soilmon/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "migrate:plan": "node --env-file-if-exists=.env scripts/migrate.js --dry-run",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "simulate": "node --env-file-if-exists=.env scripts/simulate.js",
    "user:create": "node --env-file-if-exists=.env scripts/user-create.js",
    "user:set-password": "node --env-file-if-exists=.env scripts/user-set-password.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}
