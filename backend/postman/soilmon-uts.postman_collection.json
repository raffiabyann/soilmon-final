{
  "info": {
    "name": "SoilMon API v1 (UTS)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Demo backend SoilMon. Jalankan backend dulu (npm run dev di folder backend). Request yang mengirim data menulis ke database yang dipakai backend.\n\nSebelum mulai: jalankan npm run seed, lalu isi variabel collection password* dan apiKey* dengan hasil seed. Jalankan folder 0. Login dulu: request login menyimpan token ke variabel token*."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "emailViewerA",
      "value": "viewer-a@soilmon.local"
    },
    {
      "key": "passwordViewerA",
      "value": ""
    },
    {
      "key": "emailViewerB",
      "value": "viewer-b@soilmon.local"
    },
    {
      "key": "passwordViewerB",
      "value": ""
    },
    {
      "key": "emailAdmin",
      "value": "admin@soilmon.local"
    },
    {
      "key": "passwordAdmin",
      "value": ""
    },
    {
      "key": "apiKeyNode01",
      "value": ""
    },
    {
      "key": "apiKeyNode02",
      "value": ""
    },
    {
      "key": "tokenViewerA",
      "value": ""
    },
    {
      "key": "tokenViewerB",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Login",
      "item": [
        {
          "name": "Login viewer A (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Login sebagai viewer A. Token disimpan ke variabel tokenViewerA.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailViewerA}}\",\n  \"password\": \"{{passwordViewerA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns a bearer token\", () => pm.expect(pm.response.json().data.tokenType).to.eql(\"Bearer\"));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"tokenViewerA\", pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login viewer B (200)",
          "request": {
