                "api",
                "v1",
                "telemetry"
              ]
            },
            "description": "Format yang sama dengan kiriman gateway: 7 register mentah uint16 + tegangan baterai. MENULIS ke database.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nodeCode\": \"node-01\",\n  \"rawRegisters\": [\n    512,\n    268,\n    1200,\n    65,\n    30,\n    12,\n    45\n  ],\n  \"batteryVoltage\": 3.31\n}",
              "options": {
                "raw": {
                  "language": "json"
