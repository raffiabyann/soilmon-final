# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# HTTP port. Default: 3000.
PORT=3000

# One of: development, test, production. Default: development.
NODE_ENV=development

# PostgreSQL connection string. Optional until a feature needs the database.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/soilmon

# Secret that signs and verifies user access tokens (HS256). At least 32 characters.
# Without it, every endpoint that needs a signed-in user responds 503.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=

# Device API keys for the simulator, one per node, as printed by `npm run seed`.
# SIMULATOR_API_KEYS=node-01:KEY,node-02:KEY

# Optional. Enables tests/telemetry.integration.test.js and tests/auth.integration.test.js
# against a real, already migrated PostgreSQL database. Each test runs in a transaction that is rolled back.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/soilmon
